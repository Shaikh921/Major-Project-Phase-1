# ==========================================
# CloudOps Intel Platform - Environment Template
# ==========================================

# Application
APP_NAME=Cloud Resource Monitoring & Intelligence Platform
APP_VERSION=0.1.0
APP_ENV=development

# General
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Security & Auth
# IMPORTANT: In production (ENVIRONMENT=production), you MUST supply a unique, cryptographically
# secure SECRET_KEY of at least 32 characters. Generate with: openssl rand -hex 32
# The default key below is strictly rejected in production mode.
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://127.0.0.1:8000

# Database (Absolute path recommended for Windows service persistence)
DATABASE_URL=sqlite:///C:/CLoudProject/cloud_intelligence.db

# Telemetry Ingestion Agent Authentication
# Configured pre-shared secret for telemetry collection agents and fleet simulators.
# Transmitted via the 'X-Agent-Key: <key>' request header.
# Generate with: openssl rand -hex 32
AGENT_INGESTION_KEY=replace-with-a-secure-random-agent-ingestion-key

# Database
DATABASE_URL=sqlite:///./cloud_intelligence.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Optional Bootstrap Super Admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# SMTP & Production Email Delivery Configuration
# Set SMTP_ENABLED=true and supply standard SMTP credentials for real mail dispatch
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_TLS=true
SMTP_SSL=false
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="CloudOps Intel Command Center"
SMTP_TIMEOUT_SECONDS=10

# Email Notification Triggers
NOTIFY_SUPER_ADMINS_ON_NEW_REQUEST=true
NOTIFY_ON_CRITICAL_ALERTS=false

# LLM Providers (Optional)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini

# AWS (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1