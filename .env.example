# ==========================================
# CloudOps Intel Platform - Environment Template
# ==========================================

# Application
APP_NAME=Cloud Resource Monitoring & Intelligence Platform
APP_VERSION=0.1.0
APP_ENV=development

# General
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Security & Auth
SECRET_KEY=cloudops-intel-secure-jwt-hmac-sha256-default-key-production-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://127.0.0.1:8000

# Database
DATABASE_URL=sqlite:///./cloud_intelligence.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Optional Bootstrap Super Admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# SMTP & Production Email Delivery Configuration
# Set SMTP_ENABLED=true and supply standard SMTP credentials for real mail dispatch
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_TLS=true
SMTP_SSL=false
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="CloudOps Intel Command Center"
SMTP_TIMEOUT_SECONDS=10

# Email Notification Triggers
NOTIFY_SUPER_ADMINS_ON_NEW_REQUEST=true
NOTIFY_ON_CRITICAL_ALERTS=false

# LLM Providers (Optional)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini

# AWS (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1