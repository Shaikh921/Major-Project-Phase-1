# ==============================================================================
# CloudOps Intel — Production Git Ignore Specification
# ==============================================================================

# Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
*.env
*.env.local
!*.env.example
*.pem
*.key
*.crt

# SQLite Databases & WAL Sidecars
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
sensor_spool.db*
cloud_intelligence.db*

# Caddy PKI, Local Authorities & Reverse Proxy Storage
data/caddy/
root.crt

# Windows Service Binaries & Archives
tools/
*.exe

# Archives & Large Compressed Bundles
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# Data, Model Weights & Serialized Artifacts
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep
*.npz
*.pt
*.pth
*.onnx
*.bin
*.h5
*.pkl

# Node / Frontend Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/dist/
frontend/build/

# Logs & Runtime Dumps
logs/
*.log
*.log.*

# Testing & Coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/

# Backups & Recovery Manifests
backups/
.backups/

# Operating System & IDE Clutter
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
~$*
*.tmp
*.temp
